# The Hokku desktop (built by scripts/build-packages.sh into the local [hokku] repo)
hokku
hokku-apps
hokku-desktop
hokku-os-settings

# Apps built on Hokku (packages/), in the Deskbar's Applications menu
folio
sheath
ringbinder

# What cosmoe-desktop.sh starts besides Tracker and Deskbar. labwc-hokku (provides
# labwc, from the [hokku] repo) draws Hokku's frames round other apps' windows.
labwc-hokku
polkit-gnome
xdg-desktop-portal
xdg-desktop-portal-wlr

# Login
greetd
greetd-tuigreet

# Small tools the labwc key bindings and live session use
brightnessctl
grim
htop
nm-connection-editor
pavucontrol
xdg-user-dirs

# Displays: wdisplays sets resolution, scale, arrangement and rotation; kanshi
# (started from labwc's autostart) applies the layouts in ~/.config/kanshi/config
kanshi
wdisplays

# Qt apps in the Haiku and Gonx looks (Hokku's Kvantum themes)
kvantum

# X11 apps (labwc starts Xwayland when one opens)
xorg-xwayland

# Deskbar tray applets (TrayBridge shows them; hokku-session.target starts
# them from /etc/xdg/autostart): network, volume, Bluetooth. All three are
# StatusNotifierItems, which TrayBridge needs (no XEmbed proxy is packaged
# outside Plasma).
network-manager-applet
kmix
blueman
