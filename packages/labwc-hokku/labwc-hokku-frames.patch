diff --git a/src/ssd/ssd-hokku.c b/src/ssd/ssd-hokku.c
new file mode 100644
index 0000000..6dbc616
--- /dev/null
+++ b/src/ssd/ssd-hokku.c
@@ -0,0 +1,552 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+/*
+ * Hokku's window frames round other apps' windows: Haiku's yellow tab or
+ * Gonx's, drawn by the same code as Hokku's own windows (hokku/gonx-frame.c
+ * and hokku/haiku-frame.c, from Hokku's sources) when the theme sets
+ * window.decorator. They stand in for the titlebar and border:
+ *
+ * ssd->tree (LAB_NODE_SSD_ROOT)
+ * +--border
+ * |  +--four buffers the frame is painted into: above, below and beside
+ * |  |  the window
+ * |  +--four invisible rects taking the pointer on the border, which
+ * |     ssd_get_resizing_type() places with the frame's own hit test
+ * +--titlebar (LAB_NODE_TITLEBAR)
+ *    +--invisible rects on the tab (and Gonx's shelf and flap)
+ *    +--a button (LAB_NODE_BUTTON_*) on each of the frame's buttons
+ *
+ * and above the window, in view->scene_tree, buffers for the parts of the
+ * frame that lie over the content: Gonx's rounded inner corners.
+ *
+ * The frame is repainted when the window's size, title or focus changes.
+ */
+
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <math.h>
+#include <pango/pangocairo.h>
+#include <string.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_scene.h>
+#include "buffer.h"
+#include "common/font.h"
+#include "common/list.h"
+#include "common/macros.h"
+#include "common/mem.h"
+#include "common/scene-helpers.h"
+#include "config/rcxml.h"
+#include "hokku/cairo-util.h"
+#include "hokku/gonx-frame.h"
+#include "labwc.h"
+#include "node.h"
+#include "scaled-buffer/scaled-buffer.h"
+#include "ssd.h"
+#include "ssd-internal.h"
+#include "theme.h"
+#include "view.h"
+
+enum hokku_part {
+	HOKKU_TOP,
+	HOKKU_BOTTOM,
+	HOKKU_LEFT,
+	HOKKU_RIGHT,
+	HOKKU_PART_COUNT
+};
+
+enum hokku_tab_part {
+	HOKKU_TAB,
+	HOKKU_SHELF,
+	HOKKU_FLAP,
+	HOKKU_TAB_PART_COUNT
+};
+
+/* The size of the inner corners' overlays, which Gonx draws 3x3 */
+#define HOKKU_CORNER_SIZE 4
+
+/* One of the buffers the frame is painted into */
+struct hokku_paint {
+	struct ssd_hokku *frame;
+	struct scaled_buffer *buffer;
+	struct wlr_box box; /* in the frame's coordinates */
+	bool overlay; /* the parts over the content */
+};
+
+struct ssd_hokku {
+	struct gonx_style style;
+	struct gonx_layout layout;
+	/* the frame's thickness; the frame's (0, 0) is at -left, -top */
+	struct border margin;
+	char *title;
+	bool active;
+	bool dirty;
+
+	struct hokku_paint *paint[HOKKU_PART_COUNT];
+	struct wlr_scene_tree *overlay;
+	struct hokku_paint *corner[4];
+	struct wlr_scene_rect *border_input[HOKKU_PART_COUNT];
+	struct wlr_scene_rect *tab_input[HOKKU_TAB_PART_COUNT];
+	struct wlr_scene_rect *button_input[GONX_BUTTON_COUNT];
+	struct ssd_button *button[GONX_BUTTON_COUNT];
+};
+
+/* The frame's thickness with a tab and without, for ssd_thickness() */
+static struct border hokku_sizes[2];
+
+static const enum lab_node_type button_types[GONX_BUTTON_COUNT] = {
+	[GONX_CLOSE] = LAB_NODE_BUTTON_CLOSE,
+	[GONX_ZOOM] = LAB_NODE_BUTTON_MAXIMIZE,
+	[GONX_MINIMIZE] = LAB_NODE_BUTTON_ICONIFY,
+};
+
+static void
+set_rgb(uint8_t rgb[3], const float color[4])
+{
+	/* labwc's colours are premultiplied */
+	float alpha = color[3] > 0 ? color[3] : 1;
+	for (int i = 0; i < 3; i++) {
+		rgb[i] = (uint8_t)lroundf(CLAMP(color[i] / alpha, 0, 1) * 255);
+	}
+}
+
+/*
+ * window.decorator.font, or rc.xml's titlebar font. The frame's font sizes
+ * are in pixels, as on Haiku; rc.xml's are points at 96 dpi.
+ */
+static void
+describe_font(char *out, size_t size, const struct theme *theme, bool plain)
+{
+	const char *wanted = theme->window_hokku_frame_font;
+	PangoFontDescription *desc;
+	if (wanted && *wanted) {
+		desc = pango_font_description_from_string(wanted);
+	} else {
+		desc = font_to_pango_desc(&rc.font_activewindow);
+		int pixels = (int)lround(rc.font_activewindow.size * 96.0 / 72.0);
+		pango_font_description_set_size(desc, MAX(pixels, 1) * PANGO_SCALE);
+	}
+	if (plain) {
+		/* floating windows' small tabs have plain titles */
+		pango_font_description_set_weight(desc, PANGO_WEIGHT_NORMAL);
+	}
+	char *description = pango_font_description_to_string(desc);
+	snprintf(out, size, "%s", description);
+	g_free(description);
+	pango_font_description_free(desc);
+}
+
+static void
+style_from_theme(const struct theme *theme, struct gonx_style *style)
+{
+	memset(style, 0, sizeof(*style));
+	set_rgb(style->tab, theme->window[SSD_ACTIVE].title_bg.color);
+	set_rgb(style->tab_inactive, theme->window[SSD_INACTIVE].title_bg.color);
+	set_rgb(style->text, theme->window[SSD_ACTIVE].label_text_color);
+	set_rgb(style->text_inactive,
+		theme->window[SSD_INACTIVE].label_text_color);
+	set_rgb(style->frame, theme->window[SSD_ACTIVE].border_color);
+	set_rgb(style->frame_inactive, theme->window[SSD_INACTIVE].border_color);
+	describe_font(style->title_font, sizeof(style->title_font), theme,
+		/* plain */ false);
+	describe_font(style->small_title_font, sizeof(style->small_title_font),
+		theme, /* plain */ true);
+	style->haiku = theme->window_hokku_frame == LAB_HOKKU_FRAME_HAIKU;
+}
+
+void
+ssd_hokku_theme_sizes(struct theme *theme)
+{
+	struct gonx_style style;
+	style_from_theme(theme, &style);
+
+	for (int tabless = 0; tabless <= 1; tabless++) {
+		struct border *sizes = &hokku_sizes[tabless];
+		gonx_frame_sizes(&style, /* small */ 0, tabless, &sizes->top,
+			&sizes->bottom, &sizes->left, &sizes->right);
+	}
+
+	/*
+	 * For the parts of labwc that only know a titlebar over a border of
+	 * one width (extents, shadows, window placement)
+	 */
+	theme->border_width = hokku_sizes[0].bottom;
+	theme->titlebar_height =
+		MAX(hokku_sizes[0].top - hokku_sizes[0].bottom, 1);
+}
+
+struct border
+ssd_hokku_thickness(struct view *view)
+{
+	return hokku_sizes[!view_titlebar_visible(view)];
+}
+
+static bool
+has_title_button(enum lab_node_type type)
+{
+	for (int i = 0; i < rc.nr_title_buttons_left; i++) {
+		if (rc.title_buttons_left[i] == type) {
+			return true;
+		}
+	}
+	for (int i = 0; i < rc.nr_title_buttons_right; i++) {
+		if (rc.title_buttons_right[i] == type) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+rect_valid(const struct gonx_rect *r)
+{
+	return r->right >= r->left && r->bottom >= r->top;
+}
+
+/* The frame's rect r, from frame to scene coordinates */
+static void
+place_rect(struct ssd_hokku *frame, struct wlr_scene_rect *rect,
+		struct gonx_rect r)
+{
+	if (!rect_valid(&r)) {
+		wlr_scene_node_set_enabled(&rect->node, false);
+		return;
+	}
+	wlr_scene_rect_set_size(rect, r.right - r.left + 1, r.bottom - r.top + 1);
+	wlr_scene_node_set_position(&rect->node, r.left - frame->margin.left,
+		r.top - frame->margin.top);
+	wlr_scene_node_set_enabled(&rect->node, true);
+}
+
+static struct lab_data_buffer *
+paint_create_buffer(struct scaled_buffer *scaled_buffer, double scale)
+{
+	struct hokku_paint *paint = scaled_buffer->data;
+	struct ssd_hokku *frame = paint->frame;
+
+	struct lab_data_buffer *buffer = buffer_create_cairo(
+		paint->box.width, paint->box.height, scale);
+	if (!buffer) {
+		return NULL;
+	}
+
+	cairo_t *cairo = cairo_create(buffer->surface);
+	cairo_translate(cairo, -paint->box.x, -paint->box.y);
+	if (paint->overlay) {
+		gonx_frame_paint_overlay(cairo, &frame->layout, &frame->style,
+			frame->active);
+	} else {
+		const int pressed[GONX_BUTTON_COUNT] = { 0 };
+		gonx_frame_paint(cairo, &frame->layout, &frame->style,
+			frame->title, frame->active, pressed);
+	}
+	cairo_destroy(cairo);
+	cairo_surface_flush(buffer->surface);
+	return buffer;
+}
+
+static void
+paint_destroy(struct scaled_buffer *scaled_buffer)
+{
+	free(scaled_buffer->data);
+}
+
+static bool
+paint_equal(struct scaled_buffer *a, struct scaled_buffer *b)
+{
+	/* each frame is its window's own */
+	return false;
+}
+
+static const struct scaled_buffer_impl paint_impl = {
+	.create_buffer = paint_create_buffer,
+	.destroy = paint_destroy,
+	.equal = paint_equal,
+};
+
+/* The painted frame is only seen; the rects take the pointer */
+static bool
+paint_accepts_input(struct wlr_scene_buffer *buffer, double *sx, double *sy)
+{
+	return false;
+}
+
+static void
+place_paint(struct ssd_hokku *frame, struct hokku_paint *paint,
+		struct wlr_box box)
+{
+	struct wlr_scene_node *node = &paint->buffer->scene_buffer->node;
+	paint->box = box;
+	if (wlr_box_empty(&box)) {
+		wlr_scene_node_set_enabled(node, false);
+		return;
+	}
+	wlr_scene_node_set_position(node, box.x - frame->margin.left,
+		box.y - frame->margin.top);
+	wlr_scene_node_set_enabled(node, true);
+	scaled_buffer_request_update(paint->buffer, box.width, box.height);
+}
+
+static struct hokku_paint *
+create_paint(struct ssd_hokku *frame, struct wlr_scene_tree *parent,
+		bool overlay)
+{
+	struct hokku_paint *paint = znew(*paint);
+	paint->frame = frame;
+	paint->overlay = overlay;
+	paint->buffer = scaled_buffer_create(parent, &paint_impl,
+		/* drop_buffer */ true);
+	paint->buffer->data = paint;
+	paint->buffer->scene_buffer->point_accepts_input = paint_accepts_input;
+	return paint;
+}
+
+static void
+lay_out(struct ssd_hokku *frame, struct view *view, struct gonx_layout *l)
+{
+	bool tabless = !view_titlebar_visible(view);
+	frame->margin = hokku_sizes[tabless];
+
+	memset(l, 0, sizeof(*l));
+	l->width = view->current.width + frame->margin.left
+		+ frame->margin.right;
+	l->height = view_effective_height(view, /* use_pending */ false)
+		+ frame->margin.top + frame->margin.bottom;
+	l->tabless = tabless;
+	l->resizable = 1;
+	for (int b = 0; b < GONX_BUTTON_COUNT; b++) {
+		l->has_button[b] = has_title_button(button_types[b]);
+	}
+	gonx_frame_layout(l, &frame->style, frame->title);
+}
+
+void
+ssd_hokku_update(struct ssd *ssd)
+{
+	struct ssd_hokku *frame = ssd->hokku;
+	struct view *view = ssd->view;
+	assert(frame);
+
+	/* view->title is never NULL (instead it can be an empty string) */
+	const char *title = rc.show_title ? view->title : "";
+	if (!frame->title || strcmp(frame->title, title)) {
+		xstrdup_replace(frame->title, title);
+		frame->dirty = true;
+	}
+
+	struct gonx_layout layout;
+	lay_out(frame, view, &layout);
+	if (!frame->dirty && !memcmp(&layout, &frame->layout, sizeof(layout))) {
+		return;
+	}
+	frame->layout = layout;
+	frame->dirty = false;
+
+	const struct gonx_layout *l = &frame->layout;
+	const struct border m = frame->margin;
+	const int middle = l->height - m.top - m.bottom;
+	const struct wlr_box boxes[HOKKU_PART_COUNT] = {
+		[HOKKU_TOP] = { 0, 0, l->width, m.top },
+		[HOKKU_BOTTOM] = { 0, l->height - m.bottom, l->width, m.bottom },
+		[HOKKU_LEFT] = { 0, m.top, m.left, middle },
+		[HOKKU_RIGHT] = { l->width - m.right, m.top, m.right, middle },
+	};
+	for (int i = 0; i < HOKKU_PART_COUNT; i++) {
+		place_paint(frame, frame->paint[i], boxes[i]);
+	}
+
+	/* Gonx's inner corners; Haiku's frame has none */
+	const int n = HOKKU_CORNER_SIZE;
+	const struct gonx_rect c = l->content;
+	const bool corners = !l->haiku && !view->shaded
+		&& c.right - c.left + 1 >= 2 * n && c.bottom - c.top + 1 >= 2 * n;
+	for (int i = 0; i < 4; i++) {
+		struct wlr_box box = {
+			.x = i % 2 ? c.right - n + 1 : c.left,
+			.y = i >= 2 ? c.bottom - n + 1 : c.top,
+			.width = corners ? n : 0,
+			.height = corners ? n : 0,
+		};
+		place_paint(frame, frame->corner[i], box);
+	}
+
+	/* the border round the content */
+	const struct gonx_rect b = l->border;
+	place_rect(frame, frame->border_input[HOKKU_TOP], (struct gonx_rect){
+		b.left, b.top, b.right, c.top - 1 });
+	place_rect(frame, frame->border_input[HOKKU_BOTTOM], (struct gonx_rect){
+		b.left, c.bottom + 1, b.right, b.bottom });
+	place_rect(frame, frame->border_input[HOKKU_LEFT], (struct gonx_rect){
+		b.left, c.top, c.left - 1, c.bottom });
+	place_rect(frame, frame->border_input[HOKKU_RIGHT], (struct gonx_rect){
+		c.right + 1, c.top, b.right, c.bottom });
+
+	place_rect(frame, frame->tab_input[HOKKU_TAB], l->title);
+	place_rect(frame, frame->tab_input[HOKKU_SHELF], l->shelf);
+	place_rect(frame, frame->tab_input[HOKKU_FLAP], l->flap);
+
+	for (int i = 0; i < GONX_BUTTON_COUNT; i++) {
+		if (!frame->button[i]) {
+			continue;
+		}
+		struct gonx_rect r = l->button[i];
+		struct wlr_scene_node *node = frame->button[i]->node;
+		if (!rect_valid(&r)) {
+			wlr_scene_node_set_enabled(node, false);
+			continue;
+		}
+		/* the button's node holds its rect at (0, 0) */
+		wlr_scene_rect_set_size(frame->button_input[i],
+			r.right - r.left + 1, r.bottom - r.top + 1);
+		wlr_scene_node_set_position(node, r.left - m.left, r.top - m.top);
+		wlr_scene_node_set_enabled(node, true);
+	}
+}
+
+void
+ssd_hokku_set_active(struct ssd *ssd, bool active)
+{
+	struct ssd_hokku *frame = ssd ? ssd->hokku : NULL;
+	if (!frame || frame->active == active) {
+		return;
+	}
+	frame->active = active;
+	frame->dirty = true;
+	ssd_hokku_update(ssd);
+}
+
+void
+ssd_hokku_create(struct ssd *ssd)
+{
+	struct view *view = ssd->view;
+	struct ssd_hokku *frame = znew(*frame);
+	ssd->hokku = frame;
+	style_from_theme(rc.theme, &frame->style);
+	frame->dirty = true;
+
+	/* the border goes under the titlebar, whose rects take the tab */
+	ssd->border.tree = lab_wlr_scene_tree_create(ssd->tree);
+	ssd->titlebar.tree = lab_wlr_scene_tree_create(ssd->tree);
+	node_descriptor_create(&ssd->titlebar.tree->node,
+		LAB_NODE_TITLEBAR, view, /*data*/ NULL);
+
+	/* empty, for the parts of ssd.c that switch them with the focus */
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		ssd->border.subtrees[active].tree =
+			lab_wlr_scene_tree_create(ssd->border.tree);
+		struct ssd_titlebar_subtree *subtree =
+			&ssd->titlebar.subtrees[active];
+		subtree->tree = lab_wlr_scene_tree_create(ssd->titlebar.tree);
+		wl_list_init(&subtree->buttons_left);
+		wl_list_init(&subtree->buttons_right);
+	}
+
+	for (int i = 0; i < HOKKU_PART_COUNT; i++) {
+		frame->paint[i] = create_paint(frame, ssd->border.tree,
+			/* overlay */ false);
+	}
+	frame->overlay = lab_wlr_scene_tree_create(view->scene_tree);
+	wlr_scene_node_raise_to_top(&frame->overlay->node);
+	for (int i = 0; i < 4; i++) {
+		frame->corner[i] = create_paint(frame, frame->overlay,
+			/* overlay */ true);
+	}
+
+	const float invisible[4] = { 0, 0, 0, 0 };
+	for (int i = 0; i < HOKKU_PART_COUNT; i++) {
+		frame->border_input[i] = lab_wlr_scene_rect_create(
+			ssd->border.tree, 1, 1, invisible);
+	}
+	for (int i = 0; i < HOKKU_TAB_PART_COUNT; i++) {
+		frame->tab_input[i] = lab_wlr_scene_rect_create(
+			ssd->titlebar.tree, 1, 1, invisible);
+	}
+
+	for (int i = 0; i < GONX_BUTTON_COUNT; i++) {
+		if (!has_title_button(button_types[i])) {
+			continue;
+		}
+		struct wlr_scene_tree *root =
+			lab_wlr_scene_tree_create(ssd->titlebar.tree);
+		struct ssd_button *button = znew(*button);
+		button->node = &root->node;
+		button->type = button_types[i];
+		node_descriptor_create(&root->node, button->type, view, button);
+		wl_list_append(&ssd->titlebar.subtrees[SSD_ACTIVE].buttons_right,
+			&button->link);
+		frame->button[i] = button;
+		frame->button_input[i] =
+			lab_wlr_scene_rect_create(root, 1, 1, invisible);
+	}
+
+	ssd_hokku_update(ssd);
+}
+
+void
+ssd_hokku_destroy(struct ssd *ssd)
+{
+	if (!ssd->hokku) {
+		return;
+	}
+	wlr_scene_node_destroy(&ssd->hokku->overlay->node);
+	free(ssd->hokku->title);
+	zfree(ssd->hokku);
+}
+
+/*
+ * The frame's own hit test: Haiku's border resizes the window from its edges
+ * and its bottom right corner. Returns false off the frame (in the extents),
+ * where labwc's resize areas apply.
+ */
+bool
+ssd_hokku_resizing_type(const struct ssd *ssd, struct wlr_cursor *cursor,
+		enum lab_node_type *type)
+{
+	const struct ssd_hokku *frame = ssd->hokku;
+	struct view *view = ssd->view;
+	int x = (int)floor(cursor->x) - view->current.x + frame->margin.left;
+	int y = (int)floor(cursor->y) - view->current.y + frame->margin.top;
+
+	/* Gonx's buttons stand on its shelf, which overlaps the border */
+	for (int i = 0; i < GONX_BUTTON_COUNT; i++) {
+		const struct gonx_rect *r = &frame->layout.button[i];
+		if (x >= r->left && x <= r->right && y >= r->top
+				&& y <= r->bottom) {
+			*type = LAB_NODE_NONE;
+			return true;
+		}
+	}
+
+	switch (gonx_frame_location(&frame->layout, x, y)) {
+	case THEME_LOCATION_RESIZING_TOP:
+		*type = LAB_NODE_BORDER_TOP;
+		return true;
+	case THEME_LOCATION_RESIZING_BOTTOM:
+		*type = LAB_NODE_BORDER_BOTTOM;
+		return true;
+	case THEME_LOCATION_RESIZING_LEFT:
+		*type = LAB_NODE_BORDER_LEFT;
+		return true;
+	case THEME_LOCATION_RESIZING_RIGHT:
+		*type = LAB_NODE_BORDER_RIGHT;
+		return true;
+	case THEME_LOCATION_RESIZING_TOP_LEFT:
+		*type = LAB_NODE_CORNER_TOP_LEFT;
+		return true;
+	case THEME_LOCATION_RESIZING_TOP_RIGHT:
+		*type = LAB_NODE_CORNER_TOP_RIGHT;
+		return true;
+	case THEME_LOCATION_RESIZING_BOTTOM_LEFT:
+		*type = LAB_NODE_CORNER_BOTTOM_LEFT;
+		return true;
+	case THEME_LOCATION_RESIZING_BOTTOM_RIGHT:
+		*type = LAB_NODE_CORNER_BOTTOM_RIGHT;
+		return true;
+	case THEME_LOCATION_EXTERIOR:
+		return false;
+	default:
+		/* the tab, its buttons, or the window */
+		*type = LAB_NODE_NONE;
+		return true;
+	}
+}
