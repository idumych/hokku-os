# Hokku: a labwc theme in Haiku's colours (yellow active tab, grey panels).

border.width: 1
padding.width: 6
padding.height: 3
titlebar.height: 20

window.active.border.color: #989898
window.inactive.border.color: #b4b4b4
window.active.indicator.toggled-keybind.color: #ff0000

window.active.title.bg.color: #ffd800
window.inactive.title.bg.color: #e8e8e8
window.active.title.separator.color: #989898
window.inactive.title.separator.color: #b4b4b4

window.active.label.text.color: #000000
window.inactive.label.text.color: #505050
window.label.text.justify: left

window.active.button.unpressed.image.color: #000000
window.inactive.button.unpressed.image.color: #707070
window.button.width: 20
window.button.spacing: 2
window.button.hover.bg.color: #ffffff
window.button.hover.bg.corner-radius: 0

menu.border.width: 1
menu.border.color: #989898
menu.items.bg.color: #d8d8d8
menu.items.text.color: #000000
menu.items.active.bg.color: #989898
menu.items.active.text.color: #000000
menu.separator.color: #989898
menu.title.bg.color: #ffd800
menu.title.text.color: #000000

osd.bg.color: #d8d8d8
osd.border.color: #989898
osd.border.width: 1
osd.label.text.color: #000000
osd.window-switcher.style-classic.item.active.border.color: #ffd800
osd.window-switcher.style-classic.item.active.bg.color: #ffd800

snapping.overlay.region.bg.color: #33669880
snapping.overlay.edge.bg.color: #33669880
