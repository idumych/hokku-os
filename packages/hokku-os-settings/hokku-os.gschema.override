# The Gonx look's GTK settings (gonx-gtk-settings.ini) as gsettings defaults: under
# Wayland GTK takes these over settings.ini, and Qt's gtk3 platform theme reads GTK's.
# Applying a theme in Appearance writes the user's own values.
[org.gnome.desktop.interface]
font-name='Noto Sans 6.75'
gtk-theme='Gonx'
cursor-theme='Hokku-Shadow'
