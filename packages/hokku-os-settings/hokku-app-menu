#!/bin/sh
# labwc pipemenu: the system's XDG applications (Firefox, the installer, GTK and Qt
# tools…), which Deskbar's menu doesn't list. Be apps (x-vnd.*.desktop, named by their
# signature) are left out: Deskbar has them.

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

printf '<openbox_pipe_menu>\n'
for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/local/share/applications /usr/share/applications; do
    [ -d "$dir" ] && ls "$dir"/*.desktop 2>/dev/null
done | awk -F/ '!seen[$NF]++ && $NF !~ /^x-vnd\./' | while IFS= read -r file; do
    awk -F= '
        /^\[/            { main = ($0 == "[Desktop Entry]") }
        !main            { next }
        $1 == "Name"     && name == "" { name = substr($0, 6) }
        $1 == "Exec"     { exec = substr($0, 6) }
        $1 == "Type"     { type = $2 }
        $1 == "NoDisplay" || $1 == "Hidden" { if ($2 == "true") hide = 1 }
        $1 == "Terminal" { term = ($2 == "true") }
        $1 == "OnlyShowIn" { hide = 1 }
        END {
            if (type != "Application" || hide || name == "" || exec == "") exit
            gsub(/ ?%[fFuUdDnNickvm]/, "", exec)
            if (term) exec = "Terminal " exec
            print name "\t" exec
        }' "$file"
done | sort -f | while IFS="$(printf '\t')" read -r name cmd; do
    printf '  <item label="%s"><action name="Execute"><command>%s</command></action></item>\n' \
        "$(printf %s "$name" | esc)" "$(printf %s "$cmd" | esc)"
done
printf '</openbox_pipe_menu>\n'
