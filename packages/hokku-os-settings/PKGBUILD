# Maintainer: idumych <idumych@gmail.com>
# Desktop defaults for Hokku OS: the Gonx look for new users and the session wrapper.
# labwc's settings and theme, hokku-session.target and KMix's tray entry come with
# Hokku's desktop session (hokku-desktop) since Hokku 85e62b4.
pkgname=hokku-os-settings
pkgver=2026.11.07
pkgrel=1
pkgdesc='Hokku OS desktop defaults: the Gonx look for new users and the session wrapper'
arch=(any)
url='https://github.com/idumych/hokku-os'
license=(MIT)
depends=(hokku-desktop labwc noto-fonts gawk kanshi xorg-xwayland kvantum)
optdepends=('wdisplays: display settings (resolution, scale, arrangement, rotation)'
            'grim: Print Screen key'
            'brightnessctl: brightness keys'
            'wireplumber: volume keys'
            'network-manager-applet: network applet in the Deskbar tray'
            'kmix: volume applet in the Deskbar tray'
            'blueman: Bluetooth applet in the Deskbar tray')
# gonx-*: what "gonx-theme apply" writes in a new user's ~/.config/cosmoe (it needs a
# running compositor, so it can't run before the session); regenerate them that way.
# gonx-appearance also has Appearance's ZSnake ticked (Look and feel: join submenus to the
# item they open from), on by default in Hokku OS; tick it again after regenerating.
# no-background.msg: a flattened empty BMessage, Tracker's "no background image".
# appearance-theme: the theme Appearance's Themes tab shows in use (Gonx, as above).
# labwc-environment: the cursor theme the Gonx theme and Appearance's shadows setting give.
# gonx-gtk-settings.ini, gonx-qtct.conf, gonx-kvantum.kvconfig: what applying the Gonx
# theme writes for GTK and Qt apps (Hokku's GTK and Kvantum themes of Gonx).
# hokku-os.gschema.override: the same GTK settings as gsettings defaults, which GTK prefers.
source=(hokku-session
        gonx-appearance
        gonx-fonts
        gonx-previous
        no-background.msg
        appearance-theme
        gonx-gtk-settings.ini
        gonx-qtct.conf
        gonx-kvantum.kvconfig
        labwc-environment
        hokku-os.gschema.override)
sha256sums=('318afad65410d6fd2db554a1a8305fb3523c1c90aeab6d2ab6e2016dfd0895e5'
            'b9120505ebb330d6fedea4a7cd354eed0992a8ddc0bd4c53dda327eabee549e7'
            'de5880e39e867d550c6b3463ca12db3132d1e0cd5da4209be73f7c33b64850d9'
            '944900680494da8809abf1f1bd032c60aa80f8c42ff7753de72887a66537c624'
            'c762c5df28ea71fd036b20cdc38e9a8759c5a43bca7a3b11c2ab15189a50519c'
            '4d50c951e1dce85b011da1e92e4b7ca124f2569b3167a032c6136ab7db20ca9f'
            '586c5d0a8829b9636911b955742757b8e0f5a9c871b43f19b73397a76444691a'
            '9f3d5c217122dbb842a4b34d4096ad9dc809d0798880a4aaa36e9d5b3ce3465b'
            '3768081719b9f534c30a6a37fa54bb37b5e23ee5ac0bc829c85b67142f9a6494'
            '426110fe4cb7f06799794d8fee00ff374e16287a6572d8f9992607c70dbd9775'
            'db2443cb8b8997098c1e60357358310f68fc9702bb8be9343a24895046e34926')

package() {
    install -Dm755 hokku-session "$pkgdir/usr/bin/hokku-session"
    # New users start in the Gonx look ("gonx-theme revert" goes back to Hokku's own)
    local skel="$pkgdir/etc/skel/.config/cosmoe"
    install -Dm644 gonx-appearance "$skel/system/app_server/appearance"
    install -Dm644 gonx-fonts "$skel/system/app_server/fonts"
    install -Dm644 gonx-previous "$skel/Gonx/previous"
    # what Appearance's Themes tab shows as in use
    install -Dm644 appearance-theme "$skel/Appearance theme"
    local config="$pkgdir/etc/skel/.config"
    install -Dm644 gonx-gtk-settings.ini "$config/gtk-3.0/settings.ini"
    install -Dm644 gonx-gtk-settings.ini "$config/gtk-4.0/settings.ini"
    install -Dm644 hokku-os.gschema.override \
        "$pkgdir/usr/share/glib-2.0/schemas/zz_hokku-os.gschema.override"
    install -Dm644 gonx-qtct.conf "$config/qt5ct/qt5ct.conf"
    install -Dm644 gonx-qtct.conf "$config/qt6ct/qt6ct.conf"
    install -Dm644 gonx-kvantum.kvconfig "$config/Kvantum/kvantum.kvconfig"
    install -Dm644 labwc-environment "$config/labwc/environment"
    install -Dm644 no-background.msg "$pkgdir/usr/share/hokku-os/no-background.msg"
}
