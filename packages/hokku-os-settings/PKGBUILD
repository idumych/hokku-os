# Maintainer: idumych <idumych@gmail.com>
# Desktop defaults for Hokku OS: the Gonx look for new users, the session wrapper
# (system keyboard layout), and labwc's theme and configuration to match.
pkgname=hokku-os-settings
pkgver=2026.10.31
pkgrel=5
pkgdesc='Hokku OS desktop defaults: the Gonx look, the system keyboard layout, and labwc configured to match'
arch=(any)
url='https://github.com/idumych/hokku-os'
license=(MIT)
depends=(hokku-desktop labwc noto-fonts gawk kanshi xorg-xwayland kvantum)
optdepends=('wdisplays: display settings (resolution, scale, arrangement, rotation)'
            'grim: Print Screen key'
            'brightnessctl: brightness keys'
            'wireplumber: volume keys'
            'network-manager-applet: network applet in the Deskbar tray'
            'kmix: volume applet in the Deskbar tray'
            'blueman: Bluetooth applet in the Deskbar tray')
# gonx-*: what "gonx-theme apply" writes in a new user's ~/.config/cosmoe (it needs a
# running compositor, so it can't run before the session); regenerate them that way.
# no-background.msg: a flattened empty BMessage, Tracker's "no background image".
# appearance-theme: the theme Appearance's Themes tab shows in use (Gonx, as above).
# labwc-environment: the cursor theme the Gonx theme and Appearance's shadows setting give.
# gonx-gtk-settings.ini, gonx-qtct.conf, gonx-kvantum.kvconfig: what applying the Gonx
# theme writes for GTK and Qt apps (Hokku's GTK and Kvantum themes of Gonx).
source=(rc.xml autostart themerc hokku-session gonx-appearance gonx-fonts gonx-previous
        no-background.msg hokku-session.target kmix-hokku.desktop
        appearance-theme gonx-gtk-settings.ini gonx-qtct.conf gonx-kvantum.kvconfig
        labwc-environment)
sha256sums=('a25ab8ecea76f123b1c496b8ed6e298fd4aa637bec6c928e2aa893911a3d7792'
            '65b5102b3c908ed33a2a74b34b6139edec1e9239f3d91ab25b82ef6fe6dc8598'
            '67dd72d7bc0019ce6de7ea31a97708c96d95c872761f967bfbb0127f43aabab8'
            '318afad65410d6fd2db554a1a8305fb3523c1c90aeab6d2ab6e2016dfd0895e5'
