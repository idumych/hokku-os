            '586c5d0a8829b9636911b955742757b8e0f5a9c871b43f19b73397a76444691a'
            '9f3d5c217122dbb842a4b34d4096ad9dc809d0798880a4aaa36e9d5b3ce3465b'
            '3768081719b9f534c30a6a37fa54bb37b5e23ee5ac0bc829c85b67142f9a6494'
            '426110fe4cb7f06799794d8fee00ff374e16287a6572d8f9992607c70dbd9775')

package() {
    install -Dm644 rc.xml   "$pkgdir/etc/xdg/labwc/rc.xml"
    install -Dm644 autostart "$pkgdir/etc/xdg/labwc/autostart"
    install -Dm644 themerc  "$pkgdir/usr/share/themes/Hokku/labwc/themerc"
    install -Dm755 hokku-session "$pkgdir/usr/bin/hokku-session"
    install -Dm644 hokku-session.target "$pkgdir/usr/lib/systemd/user/hokku-session.target"
    install -Dm644 kmix-hokku.desktop "$pkgdir/etc/xdg/autostart/kmix-hokku.desktop"
    # New users start in the Gonx look ("gonx-theme revert" goes back to Hokku's own)
    local skel="$pkgdir/etc/skel/.config/cosmoe"
    install -Dm644 gonx-appearance "$skel/system/app_server/appearance"
    install -Dm644 gonx-fonts "$skel/system/app_server/fonts"
    install -Dm644 gonx-previous "$skel/Gonx/previous"
    # what Appearance's Themes tab shows as in use
    install -Dm644 appearance-theme "$skel/Appearance theme"
    local config="$pkgdir/etc/skel/.config"
    install -Dm644 gonx-gtk-settings.ini "$config/gtk-3.0/settings.ini"
    install -Dm644 gonx-gtk-settings.ini "$config/gtk-4.0/settings.ini"
    install -Dm644 gonx-qtct.conf "$config/qt5ct/qt5ct.conf"
    install -Dm644 gonx-qtct.conf "$config/qt6ct/qt6ct.conf"
    install -Dm644 gonx-kvantum.kvconfig "$config/Kvantum/kvantum.kvconfig"
    install -Dm644 labwc-environment "$config/labwc/environment"
    install -Dm644 no-background.msg "$pkgdir/usr/share/hokku-os/no-background.msg"
}
