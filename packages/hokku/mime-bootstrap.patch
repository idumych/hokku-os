From 07b4aace3913edaeef1cd5dc7f1e4377c1db7dd2 Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Tue, 27 Oct 2026 19:34:25 -0700
Subject: [PATCH 1/2] cosmoe-desktop.sh: fix the first-login MIME database
 bootstrap

Package file lists (dpkg -L, rpm -ql, pacman -Ql) include directories,
which pass the -x test, and mimeset -a recurses into them. Directories
such as /usr/ made the first login scan the whole filesystem before the
desktop started (minutes in a VM) instead of the packages executables
(under a second). Register regular files only.

Also layer the system database under the user one. With the user
database alone, mimeset created empty entries for the types the apps
claim, which hid the system entries: Tracker fell back to generic icon
theme icons for folders and volumes, and DiskUsage became the folder
handler. Now those entries are copied from the system database.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cosmoe-desktop.sh | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/cosmoe-desktop.sh b/cosmoe-desktop.sh
index ca4fee0e..efd48018 100644
--- a/cosmoe-desktop.sh
+++ b/cosmoe-desktop.sh
@@ -49,11 +49,20 @@ bootstrap_mime_database() {
     command -v mimeset >/dev/null 2>&1 || return 0
 
     mkdir -p "$mime_db" || return 0
+    # Layer the system database under the user's: types the apps claim are
+    # then copied with their icons and preferred apps, instead of created
+    # empty, which would hide the system entries (no icons, and e.g. DiskUsage
+    # as the folder handler).
+    system_mime_db=
+    system_data="$(finddir B_SYSTEM_DATA_DIRECTORY 2>/dev/null || true)"
+    [ -d "$system_data/mime_db" ] && system_mime_db="$system_data/mime_db"
     if ! package_files \
         | while IFS= read -r path; do
-            [ -x "$path" ] && printf '%s\n' "$path"
+            # Package file lists include directories, which are -x too, and
+            # mimeset -a recurses into them: "/usr/" would cover the whole disk.
+            [ -f "$path" ] && [ -x "$path" ] && printf '%s\n' "$path"
         done \
-        | mimeset -a --mimedb "$mime_db" @; then
+        | mimeset -a --mimedb "$mime_db" ${system_mime_db:+--mimedb "$system_mime_db"} @; then
         return 0
     fi
     printf '%s\n' "$package_version" >"$marker"
