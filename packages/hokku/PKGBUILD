# Maintainer: idumych <idumych@gmail.com>
# Hokku: the Be/Haiku API on Linux (a fork of Cosmoe). Split like Hokku's Debian packaging:
#   hokku          libraries, add-ons, data, headers and command-line tools
#   hokku-apps     the bundled Haiku apps and preferences
#   hokku-desktop  Tracker, Deskbar and the labwc Wayland session
pkgbase=hokku
pkgname=(hokku hokku-apps hokku-desktop)
pkgver=0.9.0.r1.47d704e
pkgrel=1
_commit=47d704edcd809a04c67837d4e024c6e533f24887
pkgdesc='BeOS/Haiku-compatible C++ application framework for Linux (Hokku fork of Cosmoe)'
arch=(x86_64)
url='https://github.com/idumych/hokku'
license=(MIT)
makedepends=(git meson ninja flex bison wayland-protocols)
# Hokku fixes not pushed to github.com/idumych/hokku yet; drop each once it's on the hokku branch.
source=("hokku::git+https://github.com/idumych/hokku.git#commit=$_commit"
        session-pacman-and-vbox-only-pixman.patch)
sha256sums=(SKIP
            6133418f9a68e0413cdf3d5ec4fa180680956e0efa9dec0b053753f3b001a260)

prepare() {
    cd hokku
    git apply "$srcdir/session-pacman-and-vbox-only-pixman.patch"
}

build() {
    arch-meson hokku build -Denable_unit_test_compile=false
    meson compile -C build
}

# Move paths (relative to $pkgdir, globs allowed) from this package into another one.
_pick() {
    local dest="$srcdir/_$1" path
    shift
    pushd "$pkgdir" >/dev/null
    for path in "$@"; do
        for f in $path; do
            [ -e "$f" ] || [ -L "$f" ] || continue
            mkdir -p "$dest/$(dirname "$f")"
            mv "$f" "$dest/$f"
        done
    done
    popd >/dev/null
}

package_hokku() {
    depends=(cairo glib2 glibc icu libgcc libglvnd libicns libjpeg-turbo libpng libraw
             libstdc++ libtiff libwebp libx11 libxcursor libxkbcommon libxkbcommon-x11
             libxrandr openssl pango wayland zlib adwaita-icon-theme xcursor-themes)
    provides=(cosmoe)
    conflicts=(cosmoe)

    meson install -C build --destdir "$pkgdir"
    install -Dm644 hokku/License.md "$pkgdir/usr/share/licenses/$pkgname/License.md"

    # Regenerated by pacman hooks; a macOS-only helper; test apps not worth shipping
    rm -f "$pkgdir/usr/share/applications/mimeinfo.cache" \
          "$pkgdir/usr/share/icons/hicolor/icon-theme.cache" \
          "$pkgdir/etc/macos-bundle.sh"
    local t
    for t in gui-torture minimal minimal-noui; do
        rm -f "$pkgdir/usr/bin/$t" "$pkgdir"/usr/share/icons/hicolor/*/apps/$t.png
    done
    rm -f "$pkgdir/usr/share/applications/x-vnd.Cosmoe.gui-torture.desktop" \
          "$pkgdir/usr/share/applications/x-vnd.minimal.desktop" \
          "$pkgdir/usr/share/applications/x-vnd.minimal-noui.desktop"

    local desktop_apps=(Deskbar DeskbarPreferences Tracker TrackerPreferences)
    _pick desktop usr/bin/cosmoe-desktop.sh usr/share/wayland-sessions usr/share/cosmoe/deskbar \
        usr/share/applications/x-vnd.Be-TSKB.desktop \
        usr/share/applications/x-vnd.Cosmoe-Tracker.desktop \
        usr/share/applications/x-vnd.Haiku-Deskbar-Preferences.desktop \
        usr/share/applications/x-vnd.Haiku-TrackerPreferences.desktop
    for t in "${desktop_apps[@]}"; do
        _pick desktop "usr/bin/$t" "usr/share/icons/hicolor/*/apps/${t,,}.png"
    done

    # Everything else with a window is an app; what stays in /usr/bin are command-line tools.
    local -A tools=()
    for t in addattr catattr collectcatkeys copyattr dumpcatalog finddir findpaths getarch hey \
             linkcatkeys listattr listres message mimeset mkdepend rc roster vicn2png xres; do
        tools[$t]=1
    done
    for t in "$pkgdir"/usr/bin/*; do
        [ -n "${tools[${t##*/}]:-}" ] || _pick apps "usr/bin/${t##*/}"
    done
    _pick apps usr/share/applications usr/share/icons
}

package_hokku-apps() {
    pkgdesc='Haiku apps and preferences running on Hokku (Terminal, StyledEdit, ShowImage, Icon-O-Matic…)'
    depends=("hokku=$pkgver" cairo glib2 glibc libgcc libstdc++ pango hicolor-icon-theme)
    provides=(cosmoe-apps)
    conflicts=(cosmoe-apps)
    mv "$srcdir/_apps"/* "$pkgdir/"
    install -Dm644 hokku/License.md "$pkgdir/usr/share/licenses/$pkgname/License.md"
}

package_hokku-desktop() {
    pkgdesc='Hokku desktop session: Tracker and Deskbar on labwc (Wayland)'
    depends=("hokku=$pkgver" "hokku-apps=$pkgver" glibc libgcc libstdc++ bash dbus labwc
             mako polkit-gnome xdg-desktop-portal xdg-desktop-portal-wlr hicolor-icon-theme)
    optdepends=('pipewire: sound' 'wireplumber: sound')
    provides=(cosmoe-desktop)
    conflicts=(cosmoe-desktop)
    mv "$srcdir/_desktop"/* "$pkgdir/"
    install -Dm644 hokku/License.md "$pkgdir/usr/share/licenses/$pkgname/License.md"
}
