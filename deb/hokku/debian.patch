diff --git a/debian/cosmoe.postinst b/debian/cosmoe.postinst
new file mode 100644
index 00000000..8bde36a3
--- /dev/null
+++ b/debian/cosmoe.postinst
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Restore the xattrs that Hokku keeps its MIME database and app signatures in
+# (dumped at build time; .debs can't carry them). Each Hokku package runs
+# this, so it restores every installed package's dump.
+set -e
+
+if [ "$1" = configure ]; then
+    cd /
+    for f in usr/share/hokku/xattrs/*; do
+        [ -s "$f" ] || continue
+        # -P (don't follow symbolic links) came with an attr security update
+        # (Ubuntu's 1:2.5.2-4ubuntu0.1); Linux Lite 8.0's attr lacks it
+        if setfattr -P --help >/dev/null 2>&1; then
+            setfattr -h -P --restore="$f" || echo "warning: some Hokku attributes in $f weren't restored" >&2
+        else
+            setfattr -h --restore="$f" || echo "warning: some Hokku attributes in $f weren't restored" >&2
+        fi
+    done
+fi
+
+#DEBHELPER#
diff --git a/debian/rules b/debian/rules
index 0c06c18a..b576e227 100755
--- a/debian/rules
+++ b/debian/rules
@@ -4,7 +4,7 @@
 	dh $@
 
 override_dh_auto_clean:
-	rm -rf builddir-deb debian/tmp
+	rm -rf builddir-deb debian/tmp debian/xattrs.dump
 
 override_dh_auto_configure:
 	@:
@@ -23,3 +23,18 @@ override_dh_install:
 		install -D -m 755 debian/tmp/usr/bin/labwc-hokku \
 			debian/cosmoe-desktop/usr/bin/labwc-hokku; \
 	fi
+	# x11-utils has a listres of its own (X11 widget resources)
+	mv debian/cosmoe-dev/usr/bin/listres debian/cosmoe-dev/usr/bin/hokku-listres
+	# Hokku keeps types, app signatures and the MIME database (icons
+	# included) in xattrs, which .debs can't carry: dump each package's,
+	# for its postinst to restore.
+	(cd debian/tmp && getfattr -R -P -h -d -m '^user\.' -e base64 usr) \
+		>debian/xattrs.dump
+	grep -q BEOS: debian/xattrs.dump
+	for pkg in cosmoe cosmoe-apps cosmoe-desktop; do \
+		mkdir -p debian/$$pkg/usr/share/hokku/xattrs; \
+		awk -v root=debian/$$pkg 'BEGIN { RS = ""; ORS = "\n\n" } \
+			{ f = substr($$0, 9, index($$0, "\n") - 9) } \
+			system("test -e \"" root "/" f "\" -o -L \"" root "/" f "\"") == 0' \
+			debian/xattrs.dump >debian/$$pkg/usr/share/hokku/xattrs/$$pkg; \
+	done
