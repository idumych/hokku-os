diff --git a/debian/rules b/debian/rules
index 0c06c18a..4d295aac 100755
--- a/debian/rules
+++ b/debian/rules
@@ -4,7 +4,7 @@
 	dh $@
 
 override_dh_auto_clean:
-	rm -rf builddir-deb debian/tmp
+	rm -rf builddir-deb debian/tmp debian/xattrs.dump
 
 override_dh_auto_configure:
 	@:
@@ -15,11 +15,32 @@ override_dh_auto_build:
 override_dh_auto_install:
 	COSMOE_DEBIAN_RULES=1 $(MAKE) deb
 
-# labwc-hokku is built where the system's libraries are new enough for labwc
-# (not on Ubuntu 24.04), which leaves the session with plain labwc
+# labwc-hokku: with the system's wlroots or Hokku's, or on its own where the
+# system's libraries are too old (the Makefile; build profile
+# pkg.cosmoe.static-labwc for its build dependencies). Without it the session
+# has plain labwc.
 override_dh_install:
 	dh_install
 	if [ -e debian/tmp/usr/bin/labwc-hokku ]; then \
 		install -D -m 755 debian/tmp/usr/bin/labwc-hokku \
 			debian/cosmoe-desktop/usr/bin/labwc-hokku; \
 	fi
+	if [ -d debian/tmp/usr/share/labwc-hokku ]; then \
+		mkdir -p debian/cosmoe-desktop/usr/share; \
+		cp -a debian/tmp/usr/share/labwc-hokku debian/cosmoe-desktop/usr/share/; \
+	fi
+	# x11-utils has a listres of its own (X11 widget resources)
+	mv debian/cosmoe-dev/usr/bin/listres debian/cosmoe-dev/usr/bin/hokku-listres
+	# Hokku keeps types, app signatures and the MIME database (icons
+	# included) in xattrs, which .debs can't carry: dump each package's,
+	# for its postinst to restore.
+	(cd debian/tmp && getfattr -R -P -h -d -m '^user\.' -e base64 usr) \
+		>debian/xattrs.dump
+	grep -q BEOS: debian/xattrs.dump
+	for pkg in cosmoe cosmoe-apps cosmoe-desktop; do \
+		mkdir -p debian/$$pkg/usr/share/hokku/xattrs; \
+		awk -v root=debian/$$pkg 'BEGIN { RS = ""; ORS = "\n\n" } \
+			{ f = substr($$0, 9, index($$0, "\n") - 9) } \
+			system("test -e \"" root "/" f "\" -o -L \"" root "/" f "\"") == 0' \
+			debian/xattrs.dump >debian/$$pkg/usr/share/hokku/xattrs/$$pkg; \
+	done
diff --git a/labwc-hokku/meson.build b/labwc-hokku/meson.build
new file mode 100644
index 00000000..13420f74
--- /dev/null
+++ b/labwc-hokku/meson.build
@@ -0,0 +1,82 @@
+# labwc-hokku on its own, for systems whose libraries are too old for labwc
+# 0.20 (Ubuntu 22.04). Built apart from Hokku, so that labwc, wlroots and the
+# libraries they need newer than the system's (wayland's server, libinput,
+# libdrm, xkbcommon…, from subprojects/) are linked statically into
+# labwc-hokku while Hokku keeps the system's:
+#
+#   meson setup build labwc-hokku -Ddefault_library=static && ninja -C build
+#
+# Where the system's are new enough, Hokku's own build has labwc-hokku (the
+# labwc_hokku option) and this isn't needed.
+project('labwc-hokku', 'c',
+	meson_version: '>= 1.3.0',
+	default_options: ['default_library=static'],
+)
+
+cc = meson.get_compiler('c')
+config = configuration_data()
+config.set('HAVE_PANGO', 1)
+config.set('HAVE_STRCHRNUL', cc.has_function('strchrnul', prefix: '#define _GNU_SOURCE\n#include <string.h>') ? 1 : false)
+config.set('HAVE_BUILTIN_CLZ', cc.has_function('__builtin_clz') ? 1 : false)
+config.set('HAVE_BUILTIN_POPCOUNT', cc.has_function('__builtin_popcount') ? 1 : false)
+configure_file(output: 'config.h', configuration: config)
+
+frames_deps = [
+	dependency('cairo'),
+	dependency('pangocairo'),
+	dependency('libpng'),
+	cc.find_library('m'),
+]
+frames_inc = include_directories(
+	'.', '../headers/libs/wayland/shared', '../headers/private/interface')
+frames = static_library('hokku-frames',
+	'../src/backends/wayland/shared/gonx-frame.c',
+	'../src/backends/wayland/shared/haiku-frame.c',
+	include_directories: frames_inc,
+	dependencies: frames_deps,
+	pic: true,
+)
+meson.override_dependency('hokku-frames', declare_dependency(
+	link_with: frames,
+	include_directories: frames_inc,
+	dependencies: frames_deps,
+))
+
+# Ubuntu 22.04's Xwayland (22.1) has no xwayland.pc: what wlroots and labwc
+# read from it, from Xwayland itself
+if not dependency('xwayland', required: false).found()
+	xwayland_prog = find_program('Xwayland', required: false)
+	if xwayland_prog.found()
+		help = run_command(xwayland_prog, '-help', check: false)
+		help = help.stdout() + help.stderr()
+		has = {
+			'listenfd': '-listenfd',
+			'no_touch_pointer_emulation': '-noTouchPointerEmulation',
+			'force_xrandr_emulation': '-force-xrandr-emulation',
+			'terminate_delay': '-terminate [delay]',
+		}
+		variables = {'xwayland': xwayland_prog.full_path()}
+		foreach name, option : has
+			variables += {'have_' + name: help.contains(option) ? 'true' : 'false'}
+		endforeach
+		# "The X.Org Foundation Xwayland Version 22.1.1 (12201001)"
+		version = run_command(xwayland_prog, '-version', check: false)
+		version = (version.stdout() + version.stderr()).split('Version ')[1].split()[0]
+		meson.override_dependency('xwayland', declare_dependency(
+			version: version,
+			variables: variables,
+		))
+	endif
+endif
+
+subproject('labwc',
+	default_options: [
+		'hokku=true',
+		'man-pages=disabled',
+		'nls=disabled',
+		'labnag=disabled',
+		'systemd-session=disabled',
+		'test=disabled',
+		'werror=false',
+	],
+)
