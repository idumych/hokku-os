@@ -0,0 +1,41 @@
+ meson.build | 10 +++++-----
+ 1 file changed, 5 insertions(+), 5 deletions(-)
+diff --git a/meson.build b/meson.build
+index 8549342..0fbfa5d 100644
+--- a/meson.build
++++ b/meson.build
+@@ -6,7 +6,9 @@ project('libinput', 'c',
+ 
+ libinput_version = meson.project_version().split('.')
+ 
+-dir_data        = get_option('prefix') / get_option('datadir') / 'libinput'
++# Hokku: its own quirks, as the system's older libinput may have ones it
++# can't read (labwc-hokku installs them there)
++dir_data        = get_option('prefix') / get_option('datadir') / 'labwc-hokku' / 'libinput'
+ dir_etc         = get_option('prefix') / get_option('sysconfdir')
+ dir_overrides   = get_option('prefix') / get_option('sysconfdir') / 'libinput'
+ dir_libexec     = get_option('prefix') / get_option('libexecdir') / 'libinput'
+@@ -483,18 +485,18 @@ libinput_version_h = configure_file(
+ 
+ mapfile = dir_src / 'libinput.sym'
+ version_flag = '-Wl,--version-script,@0@'.format(mapfile)
+-lib_libinput = shared_library('input',
++# Hokku: linked statically into labwc-hokku (for systems with an older
++# libinput), which needs its header too
++lib_libinput = static_library('input',
+ 		src_libinput,
+ 		include_directories : [include_directories('.'), includes_include],
+ 		dependencies : deps_libinput,
+-		version : libinput_so_version,
+-		link_args : version_flag,
+-		link_depends : mapfile,
+-		install : true
++		pic : true,
+ 		)
+ 
+ dep_libinput = declare_dependency(
+ 		link_with : lib_libinput,
++		include_directories : include_directories('src'),
+ 		dependencies : deps_libinput)
+ 
+ meson.override_dependency('libinput', dep_libinput)
diff --git a/subprojects/packagefiles/wlroots-xcb-1.14.patch b/subprojects/packagefiles/wlroots-xcb-1.14.patch
new file mode 100644
index 00000000..be77ea98
--- /dev/null
+++ b/subprojects/packagefiles/wlroots-xcb-1.14.patch
@@ -0,0 +1,32 @@
+diff --git a/xwayland/meson.build b/xwayland/meson.build
+index 3d29dc6c..426a941f 100644
+--- a/xwayland/meson.build
++++ b/xwayland/meson.build
+@@ -6,7 +6,7 @@ xwayland_required = {
+ 	'xcb-icccm': [],
+ 	'xcb-render': [],
+ 	'xcb-res': [],
+-	'xcb-xfixes': '>=1.15',
++	'xcb-xfixes': '>=1.14', # Hokku: 1.15 only for terminate_delay
+ }
+ xwayland_optional = {
+ 	'xcb-errors': 'Required for printing X11 errors.',
+diff --git a/xwayland/xwm.c b/xwayland/xwm.c
+index f31163d9..6a2e56fe 100644
+--- a/xwayland/xwm.c
++++ b/xwayland/xwm.c
+@@ -2669,11 +2669,14 @@ struct wlr_xwm *xwm_create(struct wlr_xwayland *xwayland, int wm_fd) {
+ 		sizeof(supported)/sizeof(*supported),
+ 		supported);
+ 
++	// Hokku: libxcb 1.14 (Ubuntu 22.04) has XFixes 5, without it
++#if XCB_XFIXES_MAJOR_VERSION >= 6
+ 	if (xwm->xwayland->server->options.terminate_delay > 0 &&
+ 			xwm->xfixes_major_version >= 6) {
+ 		xcb_xfixes_set_client_disconnect_mode(xwm->xcb_conn,
+ 			XCB_XFIXES_CLIENT_DISCONNECT_FLAGS_TERMINATE);
+ 	}
++#endif
+ 
+ 	xcb_flush(xwm->xcb_conn);
+ 
